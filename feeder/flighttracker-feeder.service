[Unit]
Description=FlightTracker ADS-B feeder client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/flighttracker/venv/bin/python /opt/flighttracker/feeder.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
